# Copy this file to .streamlit/secrets.toml and paste your real values.
# NEVER commit secrets.toml (it is gitignored).
#
# How to get these:
#   1. Create a free project at https://supabase.com (exact steps: docs/WALKTHROUGH.md,
#      "Supabase setup" section).
#   2. In the Supabase dashboard: Project Settings -> API.
#   3. Copy the Project URL and the anon/public key.
#
# The anon key is safe to keep in Streamlit secrets as long as you enable
# Row Level Security (RLS) on the tables and only use policies that allow
# insert/select as shown in supabase/schema.sql.

SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_KEY = "YOUR-ANON-PUBLIC-KEY"
